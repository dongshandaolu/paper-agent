OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-6129a1d4690b4b72b71431a9dd3d505c
MODEL_NAME=deepseek-chat

# DeepSeek 不提供 Embedding API；auto 模式下会自动使用本地 TF-IDF 检索（无需外网）
# 可选值: auto | tfidf | openai | local(fastembed，需能访问 HuggingFace)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small
# 若用 OpenAI/SiliconFlow 等提供 embedding，可单独配置：
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# LOCAL_EMBEDDING_MODEL: 本地模式使用的模型，支持两种写法：
#   1. 本地路径（含路径分隔符或磁盘号）：D:\model\model-BAAI--bge-m3
#   2. HuggingFace 模型名：BAAI/bge-m3 或 sentence-transformers/paraphrase-multilingual-mpnet-base-v2
LOCAL_EMBEDDING_MODEL=D:\model\model--BAAI--bge-m3

CHROMA_PERSIST_DIR=./data/chroma
PAPERS_DIR=./data/papers
OUTPUT_DIR=./output
RETRIEVAL_TOP_K=5
RCS_TOP_K=20
RCS_FINAL_K=5
RETRIEVAL_MODE=hybrid
MAX_REFLECT_ITERATIONS=2
# SUMMARY_MODEL=deepseek-chat
